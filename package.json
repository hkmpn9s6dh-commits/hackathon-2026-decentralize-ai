{
  "name": "receipts-for-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Verifiable inference receipts: prove what a model actually said, offline.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "e2e": "node scripts/e2e.mjs",
    "cover": "node scripts/cover.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
